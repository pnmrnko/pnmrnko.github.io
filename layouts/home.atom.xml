{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
{{- $posts := first 20 (where site.RegularPages "Section" "posts") }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.Language.Lang }}">
  <title>{{ site.Title }}{{ with site.Params.tagline }} · {{ . }}{{ end }}</title>
  <link href="{{ .Permalink }}atom.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
  <id>{{ .Permalink }}</id>
  <updated>{{ (index $posts 0 | default .).Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  <author><name>{{ site.Params.author }}</name></author>
  {{- range $posts }}
  <entry>
    <title>{{ .Title }}</title>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
    <id>{{ .Permalink }}</id>
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    <content type="html">{{ .Content | html }}</content>
  </entry>
  {{- end }}
</feed>
